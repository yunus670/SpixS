
name: Build SpixSClient

on:
  push:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.12'

      - name: Find project
        id: project
        shell: bash
        run: |
          set -euo pipefail

          BUILD_FILE=$(find . -name build.gradle \
            -not -path '*/build/*' \
            -not -path '*/.gradle/*' \
            -print -quit)

          if [ -z "$BUILD_FILE" ]; then
            echo "build.gradle bulunamadı!"
            exit 1
          fi

          PROJECT_DIR=$(dirname "$BUILD_FILE")

          test -f "$PROJECT_DIR/settings.gradle"
          test -f "$PROJECT_DIR/src/main/resources/fabric.mod.json"

          echo "dir=$PROJECT_DIR" >> "$GITHUB_OUTPUT"

      - name: Build Fabric Mod
        working-directory: ${{ steps.project.outputs.dir }}
        run: gradle --no-daemon clean build

      - name: Verify JAR
        working-directory: ${{ steps.project.outputs.dir }}
        shell: bash
        run: |
          set -euo pipefail

          JAR=$(find build/libs -maxdepth 1 \
            -name 'SpixSClient-*.jar' \
            ! -name '*-sources.jar' \
            -print -quit)

          if [ -z "$JAR" ]; then
            echo "JAR oluşturulamadı!"
            exit 1
          fi

          echo "Başarılı: $JAR"

      - name: Upload JAR
        uses: actions/upload-artifact@v4
        with:
          name: SpixSClient-Fabric-1.21.4
          path: |
            ${{ steps.project.outputs.dir }}/build/libs/SpixSClient-*.jar
            !**/*-sources.jar
          if-no-files-found: error
          retention-days: 14
